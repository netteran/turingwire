# Supabase — the articles source of truth.
# Front end (public, RLS-protected read-only access):
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Canonical site origin used for absolute URLs in feeds, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://turingwire.com

# Ingest pipeline only (GitHub Actions secret — never expose to the browser):
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Admin page — dispatches the Ingest workflow from /admin.
# Fine-grained PAT with Actions: write on netteran/turingwire.
# GITHUB_DISPATCH_TOKEN=github_pat_...
# GITHUB_REPOSITORY=netteran/turingwire

# On-demand revalidation (app/api/revalidate). Any long random string; set the
# same value in the Vercel project and as the REVALIDATE_SECRET GitHub Actions
# secret, which the Ingest workflow uses to refresh pages after each run.
# REVALIDATE_SECRET=

# Admin → New article (/admin/articles/new). Server-side only; set in Vercel
# as well as in GitHub Actions, since the site can't read Actions secrets.
# Only the key for the provider behind the chosen model is needed:
# classification uses gpt-4o-mini (OpenAI) when OPENAI_API_KEY is set, else
# the `summarizer_model` setting; digesting always uses `summarizer_model`.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional OpenAI-compatible endpoint for OpenAI models:
# OPENAI_BASE_URL=https://api.openai.com/v1
